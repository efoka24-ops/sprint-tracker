generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Squad {
  id            String        @id @default(cuid())
  nom           String        @unique
  heuresParJour Float         @default(8)   // base de calcul de la capacite
  minutesDaily  Int           @default(0)   // temps de daily retire par jour ouvre, en minutes
  rolesDaily    String        @default("TECH_LEAD,DEVELOPPEUR") // roles auxquels le daily est deduit
  membres       Developpeur[]
  sprints       Sprint[]
  projets       Projet[]
  feries        JourFerie[]
  createdAt     DateTime      @default(now())
}

/** Jour ferie chome. squadId null = ferie national, valable pour toutes les squads. */
model JourFerie {
  id      String   @id @default(cuid())
  date    DateTime
  libelle String
  squad   Squad?   @relation(fields: [squadId], references: [id], onDelete: Cascade)
  squadId String?

  @@unique([date, squadId])
}

/** Absence dun collaborateur : retiree de sa capacite sur les semaines concernees. */
model Conge {
  id            String      @id @default(cuid())
  developpeur   Developpeur @relation(fields: [developpeurId], references: [id], onDelete: Cascade)
  developpeurId String
  dateDebut     DateTime
  dateFin       DateTime
  motif         String      @default("Conge")
  createdAt     DateTime    @default(now())

  @@index([developpeurId])
}

model Developpeur {
  id             String   @id @default(cuid())
  nom            String   @unique
  email          String   @unique
  motDePasse     String                        // scrypt : sel:hash
  role           String   @default("DEVELOPPEUR") // SUPER_ADMIN | SCRUM_MASTER | TECH_LEAD | DEVELOPPEUR | OBSERVATEUR
  actif          Boolean  @default(true)
  doitChangerMdp Boolean  @default(true)       // mot de passe provisoire remis par l'administrateur
  versionSession Int      @default(1)          // incrémenté pour révoquer les sessions en cours
  derniereConnexion DateTime?
  squad          Squad?   @relation(fields: [squadId], references: [id])
  squadId        String?
  entrees        Entree[]
  conges         Conge[]
  projetsPortes  ProjetPorteur[]
  userStories    UserStory[]
  createdAt      DateTime @default(now())
}

/**
 * Projet issu de la faisabilite : porte l'enveloppe estimee (heures et story
 * points) une seule fois, la ou les lignes hebdomadaires ne portent que ce qui
 * est prevu pour LEUR semaine. Un projet vit au-dela d'un sprint.
 * Un projet BLOQUE ne compte pas dans l'engagement de la squad.
 */
model Projet {
  id                String   @id @default(cuid())
  ticket            String                        // ticket Perfit, ex "#9322"
  libelle           String                        // "CXRecov"
  heuresFaisabilite Float    @default(0)          // enveloppe estimee en faisabilite
  storyPoints       Int      @default(0)
  statut            String   @default("ACTIF")    // ACTIF | BLOQUE | TERMINE
  squad             Squad?   @relation(fields: [squadId], references: [id])
  squadId           String?
  porteurs          ProjetPorteur[]
  userStories       UserStory[]
  entrees           Entree[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([squadId, ticket])
  @@index([statut])
}

/**
 * User story : maille de pilotage du projet. Elle porte l'estimation en heures,
 * d'ou les story points se DEDUISENT par le bareme (lib/storypoints.js) : ils ne
 * se saisissent jamais. Les totaux d'un projet sont la somme de ses US.
 *
 * Deux axes distincts : `etatBacklog` dit si l'item est pret a etre embarque,
 * `statut` dit ou il en est une fois embarque dans un sprint.
 */
model UserStory {
  id             String       @id @default(cuid())
  reference      String                          // ticket Perfit ou code US
  titre          String
  description    String?
  projet         Projet       @relation(fields: [projetId], references: [id], onDelete: Cascade)
  projetId       String
  porteur        Developpeur? @relation(fields: [porteurId], references: [id])
  porteurId      String?
  priorite       String       @default("MOYENNE") // HAUTE | MOYENNE | BASSE
  heuresEstimees Float        @default(0)
  storyPoints    Int          @default(0)         // derive du bareme, jamais saisi
  etatBacklog    String       @default("NOUVEAU") // NOUVEAU | A_AFFINER | AFFINE | PRET
  statut         String       @default("A_FAIRE") // A_FAIRE | EN_COURS | EN_TEST | TERMINE | BLOQUE
  sprintId       String?                          // sprint dans lequel l'US est embarquee
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([projetId])
  @@index([etatBacklog])
  @@index([sprintId])
}

/** Porteur d'un projet : CXRecov est porte par Alexandre ET Yan. */
model ProjetPorteur {
  id            String      @id @default(cuid())
  projet        Projet      @relation(fields: [projetId], references: [id], onDelete: Cascade)
  projetId      String
  developpeur   Developpeur @relation(fields: [developpeurId], references: [id], onDelete: Cascade)
  developpeurId String
  createdAt     DateTime    @default(now())

  @@unique([projetId, developpeurId])
  @@index([developpeurId])
}

model Sprint {
  id             String    @id @default(cuid())
  numero         Int                         // 1, 2, 3... (unique par squad)
  libelle        String                      // "Sprint #01"
  dateDebut      DateTime
  dateFin        DateTime
  nbSemaines     Int       @default(3)     // nombre de semaines de revue deduites de la periode
  capaciteTotale Int       @default(0)       // somme des capacites hebdomadaires calculees
  cloture        Boolean   @default(false)
  squad          Squad?    @relation(fields: [squadId], references: [id])
  squadId        String?
  semaines       Semaine[]
  retrospective  Retrospective?
  checklists     ChecklistInstance[]

  @@unique([squadId, numero])
}

/** Rétrospective et bilan d'un sprint : points forts, faibles, améliorations. */
model Retrospective {
  id             String   @id @default(cuid())
  sprint         Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  sprintId       String   @unique
  bilan          String?                      // résumé global du sprint
  pointsForts    String?                      // ce qui a bien marché
  pointsFaibles  String?                      // ce qui n'a pas marché
  ameliorations  String?                      // propositions pour le prochain sprint
  animateurId    String?                      // qui a animé la rétro
  animateurNom   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Semaine {
  id         String   @id @default(cuid())
  sprint     Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  sprintId   String
  numero     Int                        // 1 = S1, 2 = S2, 3 = S3
  dateDebut  DateTime
  dateFin    DateTime                   // vendredi = point de validation
  capacite   Int      @default(0)       // capacite calculee : jours ouvres - feries - conges
  joursOuvres Int     @default(5)       // jours travaillables de la semaine (hors feries)
  cloturee   Boolean  @default(false)
  entrees    Entree[]

  @@unique([sprintId, numero])
}

model Entree {
  id            String      @id @default(cuid())
  semaine       Semaine     @relation(fields: [semaineId], references: [id], onDelete: Cascade)
  semaineId     String
  developpeur   Developpeur @relation(fields: [developpeurId], references: [id], onDelete: Cascade)
  developpeurId String
  ticket        String                       // ticket Perfit, ex "#9673"
  projet        String                     // "HLR Manager" (libelle libre, repris du Projet quand il est rattache)
  projetRef     Projet?     @relation(fields: [projetId], references: [id])
  projetId      String?
  objectif      String                       // objectif de la semaine
  capaciteH     Float       @default(0)
  reelH         Float?
  execution     String      @default("NON_DEMARRE") // voir lib/constants.js : workflow de livraison
  valide        Boolean     @default(false)
  commentaire   String?
  blocage       String?
  historique    HistoriqueStatut[]
  rallonges     Rallonge[]
  checklists    ChecklistInstance[]
  updatedAt     DateTime    @updatedAt
  createdAt     DateTime    @default(now())

  @@index([semaineId])
}

/** Journal des publications du classeur Excel dans le depot GitHub. */
model SyncBd {
  id         String   @id @default(cuid())
  horodatage DateTime @default(now())
  raison     String
  fichier    String
  commit     String?
}

/** Trace des changements de statut : sert aux statistiques par developpeur. */
model HistoriqueStatut {
  id        String      @id @default(cuid())
  entree    Entree      @relation(fields: [entreeId], references: [id], onDelete: Cascade)
  entreeId  String
  ancien    String?
  nouveau   String
  auteurId  String?
  auteurNom String?
  date      DateTime    @default(now())

  @@index([entreeId])
  @@index([date])
}

/** Demande de rallonge : delai supplementaire accorde par le Scrum Master. */
model Rallonge {
  id            String   @id @default(cuid())
  entree        Entree   @relation(fields: [entreeId], references: [id], onDelete: Cascade)
  entreeId      String
  heures        Float    @default(0)   // heures supplementaires demandees
  motif         String
  statut        String   @default("DEMANDEE") // DEMANDEE | ACCORDEE | REFUSEE
  demandeeParId String
  demandeeParNom String?
  decideParId   String?
  decideParNom  String?
  reponse       String?
  reporterSemaineId String?            // semaine vers laquelle le point est reporte
  createdAt     DateTime @default(now())
  decideeLe     DateTime?

  @@index([entreeId])
  @@index([statut])
}

/**
 * Item du référentiel de checklist (SDD, cahier de tests, DAB, CAB ACL, CAB Go Live).
 * Géré par le super admin ; voir lib/checklists.js pour les types et les libellés par défaut.
 */
model ChecklistModeleItem {
  id        String   @id @default(cuid())
  type      String                       // SDD | TESTS | DAB | CAB_ACL | CAB_GO_LIVE
  libelle   String
  ordre     Int      @default(0)
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([type, actif])
}

/**
 * Instance de checklist : au niveau du sprint (SDD, TESTS, prérequis avant lancement)
 * ou au niveau d'une entrée/ticket (DAB, CAB ACL, CAB Go Live, avant chaque instance
 * de validation). Le Scrum Master (ou Tech Lead) valide une fois tous les items cochés ;
 * cette validation conditionne le passage au statut d'exécution suivant.
 */
model ChecklistInstance {
  id           String   @id @default(cuid())
  type         String                       // SDD | TESTS | DAB | CAB_ACL | CAB_GO_LIVE
  sprint       Sprint?  @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  sprintId     String?
  entree       Entree?  @relation(fields: [entreeId], references: [id], onDelete: Cascade)
  entreeId     String?
  statut       String   @default("EN_COURS") // EN_COURS | VALIDE
  valideParId  String?
  valideParNom String?
  valideLe     DateTime?
  items        ChecklistItem[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([sprintId])
  @@index([entreeId])
}

model ChecklistItem {
  id          String            @id @default(cuid())
  instance    ChecklistInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  instanceId  String
  libelle     String                        // copié du référentiel à la création de l'instance
  ordre       Int               @default(0)
  fait        Boolean           @default(false)
  commentaire String?
  cocheParId  String?
  cocheParNom String?
  cocheLe     DateTime?

  @@index([instanceId])
}
