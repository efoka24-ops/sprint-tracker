generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Squad {
  id        String        @id @default(cuid())
  nom       String        @unique
  membres   Developpeur[]
  sprints   Sprint[]
  createdAt DateTime      @default(now())
}

model Developpeur {
  id             String   @id @default(cuid())
  nom            String   @unique
  email          String   @unique
  motDePasse     String                        // scrypt : sel:hash
  role           String   @default("DEVELOPPEUR") // SUPER_ADMIN | SCRUM_MASTER | TECH_LEAD | DEVELOPPEUR | OBSERVATEUR
  actif          Boolean  @default(true)
  doitChangerMdp Boolean  @default(true)       // mot de passe provisoire remis par l'administrateur
  versionSession Int      @default(1)          // incrémenté pour révoquer les sessions en cours
  derniereConnexion DateTime?
  squad          Squad?   @relation(fields: [squadId], references: [id])
  squadId        String?
  entrees        Entree[]
  createdAt      DateTime @default(now())
}

model Sprint {
  id             String    @id @default(cuid())
  numero         Int                         // 1, 2, 3... (unique par squad)
  libelle        String                      // "Sprint #01"
  dateDebut      DateTime
  dateFin        DateTime
  nbSemaines     Int       @default(3)
  capaciteTotale Int       @default(600)     // heures équipe pour le sprint
  cloture        Boolean   @default(false)
  squad          Squad?    @relation(fields: [squadId], references: [id])
  squadId        String?
  semaines       Semaine[]

  @@unique([squadId, numero])
}

model Semaine {
  id         String   @id @default(cuid())
  sprint     Sprint   @relation(fields: [sprintId], references: [id], onDelete: Cascade)
  sprintId   String
  numero     Int                        // 1 = S1, 2 = S2, 3 = S3
  dateDebut  DateTime
  dateFin    DateTime                   // vendredi = point de validation
  capacite   Int      @default(200)     // capacité équipe pour la semaine
  cloturee   Boolean  @default(false)
  entrees    Entree[]

  @@unique([sprintId, numero])
}

model Entree {
  id            String      @id @default(cuid())
  semaine       Semaine     @relation(fields: [semaineId], references: [id], onDelete: Cascade)
  semaineId     String
  developpeur   Developpeur @relation(fields: [developpeurId], references: [id], onDelete: Cascade)
  developpeurId String
  ticket        String                       // "#9673"
  idPerfit      String?                      // identifiant Perfit (référentiel Orange)
  projet        String                       // "HLR Manager"
  objectif      String                       // objectif de la semaine
  capaciteH     Float       @default(0)
  reelH         Float?
  execution     String      @default("NON_DEMARRE") // NON_DEMARRE|EN_COURS|EXECUTE|BLOQUE
  valide        Boolean     @default(false)
  commentaire   String?
  blocage       String?
  updatedAt     DateTime    @updatedAt
  createdAt     DateTime    @default(now())

  @@index([semaineId])
}
