{
  "name": "sprint-tracker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "node --env-file=.env.local prisma/seed.mjs",
    "local:setup": "prisma generate --schema prisma/schema.local.prisma && prisma db push --schema prisma/schema.local.prisma --skip-generate && node --env-file=.env.local prisma/seed.mjs",
    "local:dev": "next dev",
    "prod:generate": "prisma generate",
    "test:e2e": "node tests/e2e.mjs",
    "test:calendrier": "node tests/calendrier.mjs",
    "db:recalculer": "node --env-file=.env.local prisma/recalculer.mjs",
    "bd:export": "node --env-file=.env.local prisma/exporter-bd.mjs",
    "bd:publier": "npm run bd:export && git add bd && git commit -m \"bd : mise a jour du classeur\" && git push"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "next": "^15.1.6",
    "pptxgenjs": "^4.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "prisma": "^6.2.1"
  }
}
